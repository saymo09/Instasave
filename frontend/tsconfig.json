{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "noUnusedLocals": true,
    "noImplicitReturns": true, "noFallthroughCasesInSwitch": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "types": ["node"]
  },
  "include": ["src", "tests"]
}
