# InstaSave — variáveis de ambiente (nenhum segredo é necessário)
INSTASAVE_HOST=127.0.0.1
INSTASAVE_PORT=8000
# Caminho do yt-dlp (opcional). Se vazio, procura "yt-dlp" no PATH.
INSTASAVE_YTDLP_PATH=
# Limite por arquivo em MB
INSTASAVE_MAX_FILE_MB=100
# Confiar no cabeçalho X-Forwarded-For (somente atrás de proxy reverso confiável)
INSTASAVE_TRUST_PROXY=0
# Requisições por minuto por IP
INSTASAVE_RESOLVE_PER_MIN=10
INSTASAVE_MEDIA_PER_MIN=40
# Pasta do frontend compilado
INSTASAVE_STATIC_DIR=../frontend/dist
